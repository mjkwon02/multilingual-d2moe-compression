# python
__pycache__/
*.pyc
.venv/

# large intermediates (never committed; regenerated by the GPU pipeline)
*.safetensors
fisher_layers/
svd_scale_layers/
# exception: the per-layer whitening eigenvalue summaries (small JSON,
# provenance for the Qwen runs) are part of the release tree
!results/qwen/phase1/_layer_meta/**/svd_scale_layers/
fisher_processed.pt
svd_scale_processed.pt
third_party/D2MoE/

# HF caches
hf_cache/
.cache/

# XL-Sum raw tarball cache and rebuilt corpus text (CC BY-NC-SA 4.0 —
# not redistributed; rebuild with scripts/calibration/e2_build_ood_corpus.py)
data/xlsum_raw/
data/ood_xlsum/*.txt

# note: run logs preserved as provenance live in docs/provenance/ and are
# intentionally NOT ignored; do not add a blanket *.log rule (the legacy
# repository lost its pre-registration ledgers to one).

# qwen15_table1_aggregate.py emits a timestamped snapshot triplet on every
# run alongside the canonical table1_qwen_seeds012.{csv,json,md}; the
# snapshots are content-identical to the canonical files and need not be
# committed (historical snapshots archived privately 2026-11-23).
results/qwen/phase1/report/table1_qwen_seeds012.2*
